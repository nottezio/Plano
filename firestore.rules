rules_version = '2';

/**
 * SPEC 8 — access control.
 *
 * Deviation from the spec draft, deliberate: the draft allowed `delete` on
 * patients. SPEC 1.5 forbids hard deletes from the client, and a rule that
 * permits what the app promises never to do is not a rule — it is a bug
 * waiting for a stray call site or a compromised session. Deletion of
 * user-authored content is denied *at the server*, so "soft-delete only" is
 * enforced rather than merely intended.
 *
 * The one exception is entries/{date}/revisions, which are derived safety
 * snapshots capped at 30. Pruning the oldest is a hard delete by design.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function authed() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return authed() && request.auth.uid == uid;
    }

    /*
     * ACCESS CONTROL (see src/domain/access.ts for the whole model).
     *
     * The one admin, by UID. Written here rather than stored in a document,
     * so there is no data anyone could write to become admin. A client test
     * checks this literal matches `ADMIN_UID`.
     */
    function isAdmin() {
      return authed() && request.auth.uid == 'Wh7oXHHQfadqM8UWQubBi2iyj0i2';
    }

    // The switch. Absent or false: every signed-in account is allowed, as
    // before this existed. `get('enforce', false)` so a document without the
    // field reads as off rather than erroring.
    function accessEnforced() {
      return exists(/databases/$(database)/documents/config/access)
        && get(/databases/$(database)/documents/config/access).data.get('enforce', false) == true;
    }

    function isApproved() {
      return exists(/databases/$(database)/documents/access/$(request.auth.uid))
        && get(/databases/$(database)/documents/access/$(request.auth.uid)).data.get('status', '') == 'approved';
    }

    // Every data path goes through this. Ordered so the admin costs no extra
    // read, and an unenforced project costs one `exists`.
    /*
     * Google only. Switching the Email/Password provider off in Firebase stops
     * NEW password sign-ins, but a session made with a password before that
     * keeps a valid token indefinitely. Without this, such a session kept full
     * access to every data path. The admin is exempt so a mistake here can
     * never lock the owner out.
     */
    function signedInWithGoogle() {
      return request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function allowed() {
      return authed() && (isAdmin() || (signedInWithGoogle() && (!accessEnforced() || isApproved())));
    }

    // A list viewer (22 Oct 2026): admitted only to READ the List Maker lists
    // it is a member of, and to accept or leave an invite. Nothing else.
    function isViewer() {
      return exists(/databases/$(database)/documents/access/$(request.auth.uid))
        && get(/databases/$(database)/documents/access/$(request.auth.uid)).data.get('status', '') == 'viewer';
    }
    function seesLists() {
      return allowed() || (authed() && signedInWithGoogle() && accessEnforced() && isViewer());
    }

    function isMemberOf(data) {
      return allowed() && request.auth.uid in data.memberIds;
    }

    // Costs one document read per subcollection rule evaluation. Acceptable at
    // ward scale (tens of patients, one user); documented rather than hidden.
    function isMember(pid) {
      return allowed() &&
             request.auth.uid in
               get(/databases/$(database)/documents/patients/$(pid)).data.memberIds;
    }

    // What a user's own app may write to its access record: never `status`.
    // Mirrored by REGISTRY_KEYS in src/domain/access.ts, checked by a test.
    function registryKeys() {
      return ['uid', 'email', 'displayName', 'firstSeenAt', 'lastSeenAt', 'device', 'appVersion', 'stats'];
    }

    // The record may not claim another account's uid or email: the admin
    // decides by what it shows. The email is the one Google signed.
    function honestRegistry(uid) {
      return (!('uid' in request.resource.data) || request.resource.data.uid == uid)
        && (!('email' in request.resource.data)
            || request.resource.data.email == request.auth.token.email);
    }

    // What sign-in writes to the profile before access is decided, so the
    // waiting screen can load. Nothing else is writable until approved.
    function bootstrapKeys() {
      return ['uid', 'displayName', 'email', 'schemaVersion', 'settings', 'createdAt'];
    }

    match /patients/{pid} {
      // A field read rather than `get()` with a default, so a query filtered
      // on `transferTo` can be proven against it (as floor invites are).
      // `transferTo` is the recipient's uid (picked from a shared list) or,
      // as a fallback, their lowercase email; a uid never contains '@'.
      function isTransferTarget(data) {
        return allowed()
          && (data.transferTo == request.auth.uid
              || data.transferTo == request.auth.token.email.lower());
      }

      // `resource` is null for a document that does not exist on the server
      // yet. Evaluating `resource.data` in that case throws, the rule denies,
      // and the listener errors out — which is exactly what happened when a
      // patient created offline was opened before its write had landed.
      // Allowing reads of non-existent documents reveals nothing: the snapshot
      // simply comes back empty.
      allow read: if allowed()
        && (resource == null || isMemberOf(resource.data) || isTransferTarget(resource.data));

      allow create: if allowed()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.deletedAt == null;

      // Members never change the owner; sharing happens by adding to
      // memberIds only. A member may send (or cancel) a handover, signed as
      // themselves: `transferFrom` is either unchanged or their own uid.
      // The owner stays a member, so no member can lock the owner out.
      allow update: if isMemberOf(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.auth.uid in request.resource.data.memberIds
        && resource.data.ownerId in request.resource.data.memberIds
        && (!('transferFrom' in request.resource.data)
            || request.resource.data.transferFrom == resource.data.get('transferFrom', null)
            || request.resource.data.transferFrom.uid == request.auth.uid);

      /*
       * Handover (src/domain/transfer.ts): the account a patient was sent to
       * may read the patient document (not its notes: those check memberIds)
       * and either decline, clearing the request and nothing else, or accept,
       * becoming the sole owner and member. Ownership changes ONLY this way,
       * and only to the person the current members chose. Accepting also
       * makes it an active, undeleted, non-Titipan patient (whatever the
       * sender left it as); declining may not touch any of that.
       */
      allow update: if isTransferTarget(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['ownerId', 'memberIds', 'transferTo', 'transferToName', 'transferFrom',
                       'status', 'archive', 'deletedAt', 'temporary', 'updatedAt', 'updatedBy'])
        && !('transferTo' in request.resource.data)
        && !('transferToName' in request.resource.data)
        && !('transferFrom' in request.resource.data)
        && ((request.resource.data.ownerId == request.auth.uid
             && request.resource.data.memberIds == [request.auth.uid]
             && request.resource.data.status == 'active'
             && request.resource.data.deletedAt == null)
            || (request.resource.data.ownerId == resource.data.ownerId
                && request.resource.data.memberIds == resource.data.memberIds
                && !request.resource.data.diff(resource.data).affectedKeys()
                     .hasAny(['status', 'archive', 'deletedAt', 'temporary'])));

      /**
       * Hard delete, for emptying the trash.
       *
       * This used to be `if false`, on the rule that nothing is ever destroyed
       * and the revision trail is the only reason an accidental clear is
       * recoverable. That still holds for CLEARING a note, which stays soft.
       *
       * Emptying the trash is a different act: it is explicit, it names what
       * it will destroy, and its whole purpose is to stop paying to store a
       * patient who was discharged months ago. A trash that only hides things
       * is not a trash.
       *
       * Members only, and the client must delete the subcollections first —
       * Firestore does not cascade, and `isMember` reads the PARENT document,
       * so removing the patient first would lock its own children in place,
       * unreadable and undeletable but still stored.
       */
      allow delete: if isMemberOf(resource.data);

      match /entries/{date} {
        allow read, create: if isMember(pid);

        /*
         * COMPARE-AND-SET on the body, which is what stops a note reverting.
         *
         * A body write carries `baseHash`: the hash of the body its writer
         * had last seen CONFIRMED. This accepts it only if that is still what
         * the entry holds. A write built on an older version — typically one
         * that sat in a device's offline queue for hours and is only now
         * being delivered — is refused instead of replacing the newer note.
         *
         * Refusing is only safe because the client keeps its own outbox: a
         * refused write is merged against the current body and written again
         * (`reconcileOutbox`), so the edit is not lost, it is late.
         *
         * Writes WITHOUT `baseHash` are unaffected: locking, presence,
         * shift notes, the preview and the explicit clear, none of which
         * replace a body behind someone's back. Older app versions also have
         * none, so they keep working as before until they update.
         */
        allow update: if isMember(pid) && (
          !('baseHash' in request.resource.data)
          // `get` with the incoming value as the default: an entry stored
          // before `bodyHash` existed cannot be checked, and a rule that
          // denied it would refuse that write forever, with the client
          // retrying it forever.
          || request.resource.data.baseHash
             == resource.data.get('bodyHash', request.resource.data.baseHash)
          || request.resource.data.body == resource.data.body
        );
        // Allowed only so `purgePatient` can empty this collection before the
        // patient itself goes. Clearing a single note remains soft — see
        // `clearEntry`, which writes `deletedAt` and keeps the body's history.
        allow delete: if isMember(pid);

        match /revisions/{revisionId} {
          allow read, create: if isMember(pid);
          // A revision is an immutable snapshot. Editing one would destroy the
          // only recoverable copy of a conflicting version.
          allow update: if false;
          allow delete: if isMember(pid);
        }
      }

      match /checklist/{date} {
        allow read, create, update: if isMember(pid);
        // Same reason as entries: purge needs to empty it first.
        allow delete: if isMember(pid);
      }
    }

    match /users/{uid} {
      // Readable by its owner even before approval: it carries the settings
      // the app needs to render at all, including the waiting screen.
      // Deliberately NOT readable by the admin: it also holds Catatan notes.
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && (allowed() || request.resource.data.keys().hasOnly(bootstrapKeys()));
      allow update: if isSelf(uid)
        && (allowed()
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(bootstrapKeys()));
      allow delete: if false;

      match /documents/{documentId} {
        allow read, create, update: if isSelf(uid) && allowed();
        allow delete: if false;
      }

      // Images in board sticky notes, one per document (see paths.ts).
      // Immutable once written: an image is replaced by adding another, and
      // removing one from a note only drops its id there. The size bound is
      // well under the 1 MiB document cap, so a write can never be the one
      // that fails for size, whatever the client did before sending it.
      match /boardImages/{imageId} {
        allow read: if isSelf(uid) && allowed();
        allow create: if isSelf(uid) && allowed()
          && request.resource.data.dataUrl is string
          && request.resource.data.dataUrl.size() < 900000
          // Checked on a small field, not by a regex over the image itself:
          // a pattern run across ~900 KB is a rule-engine limit waiting to
          // be found in production.
          && request.resource.data.mime in ['image/jpeg', 'image/png'];
        allow update, delete: if false;
      }

      // Konfirmasi Jaga: parsed rosters and working state, owner only.
      // The id is limited to the five documents the app writes, so this
      // path cannot become a general-purpose store. No delete: a roster is
      // replaced by the next import, and state keys are removed field by
      // field, never by deleting the document.
      match /jaga/{docId} {
        allow read: if isSelf(uid) && allowed();
        allow create, update: if isSelf(uid) && allowed()
          && docId in ['roster', 'dpjp', 'jarkom', 'pediatri', 'state'];
        allow delete: if false;
      }

      // Saved Helper results: a finished census, Formasi or message, owner
      // only (see src/domain/helperResults.ts). The text bound matches
      // MAX_RESULT_CHARS, checked by a client test. No delete: removing one
      // writes `deletedAt`, so a mistaken delete can be undone on any device.
      match /helperResults/{resultId} {
        allow read: if isSelf(uid) && allowed();
        allow create, update: if isSelf(uid) && allowed()
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 100000
          && request.resource.data.kind is string;
        allow delete: if false;
      }

      // Sensus history: one DPJP's census per day (see
      // src/domain/census/evolution.ts), owner only. Bounded so a write can
      // never approach the document cap. No delete: a day is replaced by
      // re-copying it.
      match /sensusDays/{dayId} {
        allow read: if isSelf(uid) && allowed();
        allow create, update: if isSelf(uid) && allowed()
          && request.resource.data.code is string
          && request.resource.data.date is string
          && request.resource.data.patients is list
          && request.resource.data.patients.size() <= 300;
        allow delete: if false;
      }

      match /templates/{templateId} {
        allow read, create, update, delete: if isSelf(uid) && allowed();
      }

      // Buat Sensus input per tanggal sensus (12.6): the pasted lists, AI
      // results and ticks (src/domain/census/makerSync.ts), owner only.
      // Transient working data, so delete IS allowed: a day emptied by the
      // user or older than a week is removed. Firestore's own 1 MiB cap
      // bounds the size; the client keeps an oversized day local.
      match /sensusInput/{date} {
        allow read, delete: if isSelf(uid) && allowed();
        allow create, update: if isSelf(uid) && allowed()
          && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.date == date
          && (!('lists' in request.resource.data) || (request.resource.data.lists is list
            && request.resource.data.lists.size() <= 30));
      }

      // The account's Anthropic key and AI switches (12.6, Avi's choice),
      // owner only, one document. Not part of the profile so it never enters
      // Export data. No delete: clearing writes an empty key.
      match /private/{docId} {
        allow read: if isSelf(uid) && allowed() && docId == 'ai';
        allow create, update: if isSelf(uid) && allowed() && docId == 'ai'
          && request.resource.data.key is string
          && request.resource.data.key.size() <= 400
          && request.resource.data.flags is map;
        allow delete: if false;
      }
    }

    /*
     * List Maker floors (12.8): a floor list shared by its members
     * (src/domain/floorList/floor.ts, src/data/repositories/floors.repo.ts).
     *
     * - read: members, and anyone whose email is invited (to see the invite);
     * - the OWNER manages everything on the floor document (name, roles,
     *   invites, members) but cannot hand the floor to someone else;
     * - an EDIT member may change only the nicknames, the chiefs, the Chief
     *   Bangsal (24 Oct 2026), the junior roster (12.12) and the
     *   (pre-12.12) hand-entered patients;
     * - an invitee may accept: add THEMSELVES, with exactly the invited role,
     *   and remove their own invite — nothing else;
     * - any member may leave (remove only themselves);
     * - days: members read, edit members (and the owner) write;
     * - the OWNER may delete the list (12.12): its patients, editions,
     *   days and Catatan Visite first (checked through this document), then
     *   the document.
     */
    match /floors/{floorId} {
      function myEmail() {
        return request.auth.token.email.lower();
      }
      function isFloorOwner() {
        return request.auth.uid == resource.data.ownerUid;
      }
      function isFloorEditor() {
        return isFloorOwner()
          || (request.auth.uid in resource.data.roles && resource.data.roles[request.auth.uid] == 'edit');
      }
      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      function acceptsInvite() {
        return myEmail() in resource.data.inviteEmails
          && !(request.auth.uid in resource.data.memberIds)
          && changed().hasOnly(['memberIds', 'roles', 'names', 'invites', 'inviteEmails', 'updatedAt'])
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.roles[request.auth.uid] == resource.data.invites[myEmail()]
          && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.invites.diff(resource.data.invites).affectedKeys().hasOnly([myEmail()])
          && !(myEmail() in request.resource.data.invites)
          && !(myEmail() in request.resource.data.inviteEmails);
      }
      function leaves() {
        return request.auth.uid in resource.data.memberIds
          && !isFloorOwner()
          && changed().hasOnly(['memberIds', 'roles', 'names', 'updatedAt'])
          && !(request.auth.uid in request.resource.data.memberIds)
          && resource.data.memberIds.hasAll(request.resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
          && request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid]);
      }

      /*
       * The owner hands the list to another MEMBER (28 Oct 2026, Avi: transfer
       * it to the new Penanggung jawab). Only `ownerUid` and the roles change:
       * the new owner must already be a member and is made an editor, and the
       * previous owner stays on the list as an editor. Nobody is added or
       * removed by it.
       */
      function transfersOwnership() {
        return isFloorOwner()
          && changed().hasOnly(['ownerUid', 'roles', 'updatedAt'])
          && request.resource.data.ownerUid != resource.data.ownerUid
          && request.resource.data.ownerUid in resource.data.memberIds
          && request.resource.data.roles[request.resource.data.ownerUid] == 'edit'
          && request.resource.data.roles[resource.data.ownerUid] == 'edit'
          && request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([request.resource.data.ownerUid]);
      }

      allow read: if seesLists()
        && (request.auth.uid in resource.data.memberIds || myEmail() in resource.data.inviteEmails);
      allow create: if allowed()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.roles[request.auth.uid] == 'edit'
        && request.resource.data.inviteEmails is list
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80;
      allow update: if allowed() && (
        (isFloorOwner()
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.roles[request.auth.uid] == 'edit'
          && request.resource.data.memberIds.size() <= 60)
        || transfersOwnership()
        || (isFloorEditor() && changed().hasOnly(['nicknames', 'manual', 'chiefs', 'chiefBangsal', 'juniors', 'marks', 'analysisTitles', 'updatedAt']))
        || acceptsInvite()
        || leaves()
      ) || (seesLists() && (acceptsInvite() || leaves()));
      allow delete: if allowed() && isFloorOwner();

      // The roster (12.12): one document per patient. Members read; edit
      // members add and update (SOAP, status, residents). A patient who leaves
      // keeps the record with status pulang/pindah; deleting is for mistakes.
      match /patients/{key} {
        function floorP() {
          return get(/databases/$(database)/documents/floors/$(floorId)).data;
        }
        allow read: if seesLists() && request.auth.uid in floorP().memberIds;
        allow create, update: if allowed()
          && (request.auth.uid == floorP().ownerUid
            || (request.auth.uid in floorP().roles && floorP().roles[request.auth.uid] == 'edit'))
          && request.resource.data.report is map
          && request.resource.data.status in ['dirawat', 'pulang', 'pindah'];
        // The owner (deleting the list) or an edit member erasing one patient
        // entered by mistake (12.12). A patient who went home is "pulang".
        allow delete: if allowed()
          && (request.auth.uid == floorP().ownerUid
            || (request.auth.uid in floorP().roles && floorP().roles[request.auth.uid] == 'edit'));
      }

      // Sent lists (12.12): written once by an edit member, never changed.
      match /editions/{editionId} {
        function floorE() {
          return get(/databases/$(database)/documents/floors/$(floorId)).data;
        }
        allow read: if seesLists() && request.auth.uid in floorE().memberIds;
        allow create: if allowed()
          && (request.auth.uid == floorE().ownerUid
            || (request.auth.uid in floorE().roles && floorE().roles[request.auth.uid] == 'edit'))
          && request.resource.data.text is string
          && request.resource.data.patients is list;
        allow update: if false;
        // The owner or an edit member deletes a list saved twice or by
        // mistake (13.14); the roster is separate and untouched.
        allow delete: if allowed()
          && (request.auth.uid == floorE().ownerUid
            || (request.auth.uid in floorE().roles && floorE().roles[request.auth.uid] == 'edit'));
      }

      // Restore points (2026-10-16): the roster as it was before a paste and
      // with each edition, so a bad import can be undone. Written once by an
      // edit member, never changed; deleted when pruned (newest 30 kept).
      // The patients are JSON text in `parts` (a full floor can pass 1 MiB).
      match /restores/{pointId} {
        function floorR() {
          return get(/databases/$(database)/documents/floors/$(floorId)).data;
        }
        function editsR() {
          return request.auth.uid == floorR().ownerUid
            || (request.auth.uid in floorR().roles && floorR().roles[request.auth.uid] == 'edit');
        }
        allow read: if seesLists() && request.auth.uid in floorR().memberIds;
        allow create: if allowed() && editsR()
          && request.resource.data.kind in ['tempel', 'edisi', 'pulihkan']
          && request.resource.data.createdAt is string
          && request.resource.data.parts is int;
        allow update: if false;
        allow delete: if allowed() && editsR();

        match /parts/{n} {
          allow read: if seesLists() && request.auth.uid in floorR().memberIds;
          allow create: if allowed() && editsR() && request.resource.data.json is string;
          allow update: if false;
          allow delete: if allowed() && editsR();
        }
      }

      // Catatan Visite (24 Oct 2026): one shared note per list. Members read;
      // only the owner and edit members write (a viewer's window is read-only).
      match /visitNote/{noteId} {
        function floorV() {
          return get(/databases/$(database)/documents/floors/$(floorId)).data;
        }
        function editsV() {
          return request.auth.uid == floorV().ownerUid
            || (request.auth.uid in floorV().roles && floorV().roles[request.auth.uid] == 'edit');
        }
        allow read: if seesLists() && request.auth.uid in floorV().memberIds;
        allow create, update: if allowed() && editsV() && noteId == 'main'
          && request.resource.data.keys().hasOnly(['body', 'updatedBy', 'updatedAt'])
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 200000;
        allow delete: if allowed() && request.auth.uid == floorV().ownerUid;
      }

      match /days/{date} {
        function floor() {
          return get(/databases/$(database)/documents/floors/$(floorId)).data;
        }
        allow read: if seesLists() && request.auth.uid in floor().memberIds;
        allow create, update: if allowed()
          && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.date == date
          && (request.auth.uid == floor().ownerUid
            || (request.auth.uid in floor().roles && floor().roles[request.auth.uid] == 'edit'));
        allow delete: if allowed() && request.auth.uid == floor().ownerUid;
      }
    }

    /*
     * One record per account: registration details and the admin's decision.
     * Created by the user's own app as `pending`. Only the admin can change
     * `status`. Never deleted: revoking is `status: 'revoked'`, which keeps
     * who decided and when.
     */
    match /access/{uid} {
      allow get: if isAdmin() || isSelf(uid);
      allow list: if isAdmin();
      allow create: if isAdmin()
        || (isSelf(uid)
            && request.resource.data.status == 'pending'
            && request.resource.data.keys().hasOnly(registryKeys().concat(['status']))
            && honestRegistry(uid));
      allow update: if isAdmin()
        || (isSelf(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(registryKeys())
            && honestRegistry(uid));
      allow delete: if false;
    }

    // The enforcement switch. Every signed-in app reads it to know whether to
    // show the waiting screen; only the admin sets it.
    match /config/{docId} {
      allow get: if authed() && docId == 'access';
      allow create, update: if isAdmin() && docId == 'access';
      allow delete: if false;
    }

    /*
     * Usernames (src/domain/username.ts): one document per handle, holding
     * the owner's uid and name. Read one at a time by its exact handle, never
     * listed, so the collection cannot be used as a directory of accounts.
     * Claimed together with `username` on the owner's profile (`getAfter`),
     * and released only once the profile has moved off it.
     */
    match /usernames/{handle} {
      allow get: if allowed();
      allow list: if false;
      allow create: if allowed()
        && handle.matches('^[a-z0-9][a-z0-9._]{1,18}[a-z0-9]$')
        && request.resource.data.keys().hasOnly(['uid', 'name'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('username', '') == handle;
      allow update: if allowed()
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80;
      allow delete: if allowed()
        && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('username', '') != handle;
    }

    /*
     * Bug reports and suggestions (src/domain/feedback.ts). Anyone admitted,
     * list viewers included, may send one as themselves; only the admin reads
     * them and marks them done. Never deleted: done is `status: 'selesai'`.
     * The text bound matches MAX_FEEDBACK_CHARS and the log bound the session
     * log's LIMIT, checked by a client test.
     */
    match /feedback/{id} {
      allow create: if seesLists()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'kind', 'text', 'status', 'createdAt', 'device', 'log'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.kind in ['bug', 'fitur']
        && request.resource.data.status == 'baru'
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000
        && request.resource.data.device is map
        && request.resource.data.log is list
        && request.resource.data.log.size() <= 40;
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
